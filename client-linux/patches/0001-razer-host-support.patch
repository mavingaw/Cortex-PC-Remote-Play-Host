+QImage BoxArtManager::downloadImage(const QUrl& url)
+{
+    // Runs on a worker thread: use a private network manager with its own event loop
+    QNetworkAccessManager nam;
+    QNetworkRequest request(url);
+    request.setAttribute(QNetworkRequest::RedirectPolicyAttribute, QNetworkRequest::NoLessSafeRedirectPolicy);
+    QNetworkReply* reply = nam.get(request);
+
+    QEventLoop loop;
+    QObject::connect(reply, &QNetworkReply::finished, &loop, &QEventLoop::quit);
+    QTimer::singleShot(REMOTE_BOX_ART_TIMEOUT_MS, &loop, &QEventLoop::quit);
+    loop.exec(QEventLoop::ExcludeUserInputEvents);
+
+    QImage image;
+    if (!reply->isFinished()) {
+        qWarning() << "Timed out downloading box art from" << url.toString();
+        reply->abort();
+    }
+    else if (reply->error() != QNetworkReply::NoError) {
+        qWarning() << "Failed to download box art from" << url.toString() << ":" << reply->errorString();
+    }
+    else if (reply->bytesAvailable() > REMOTE_BOX_ART_MAX_BYTES) {
+        qWarning() << "Box art from" << url.toString() << "is too large";
+    }
+    else {
+        image = QImageReader(reply).read();
+    }
+    delete reply;
+    return image;
+}
